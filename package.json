{
  "name": "cikal",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:secrets": "node scripts/dev-secrets.mjs",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && turbo run typecheck test build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  }
}
