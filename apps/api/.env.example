# Salin ke apps/api/.env untuk menjalankan api di luar Docker. Jalankan `pnpm dev:secrets` lebih dulu.
APP_ENV=dev
APP_VERSION=0.0.0
PORT=3000
PROCESS_ROLE=api
DATABASE_URL=postgres://cikal:cikal@localhost:55432/cikal
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cikal-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_FILE=../../deploy/compose/.secrets/s3_access_key
S3_SECRET_KEY_FILE=../../deploy/compose/.secrets/s3_secret_key
MONITORING_TOKEN_FILE=../../deploy/compose/.secrets/monitoring_token
ENABLE_RESET_API=true
RESET_API_TOKEN_FILE=../../deploy/compose/.secrets/reset_token
LOG_LEVEL=debug
