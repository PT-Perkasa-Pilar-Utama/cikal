# Salin ke apps/api/.env untuk menjalankan api di luar Docker. Jalankan `pnpm dev:secrets` lebih dulu.
APP_ENV=dev
APP_VERSION=0.0.0
PORT=3000
PROCESS_ROLE=api
DATABASE_URL=postgres://cikal_app:cikal_app@localhost:55432/cikal
DATABASE_MIGRATION_URL=postgres://cikal_owner:cikal_owner@localhost:55432/cikal
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cikal-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_FILE=../../deploy/compose/.secrets/s3_access_key
S3_SECRET_KEY_FILE=../../deploy/compose/.secrets/s3_secret_key
GOTENBERG_URL=http://localhost:3001
SESSION_COOKIE_SECURE=false
MONITORING_TOKEN_FILE=../../deploy/compose/.secrets/monitoring_token
ENABLE_RESET_API=true
RESET_API_TOKEN_FILE=../../deploy/compose/.secrets/reset_token
DEFAULT_RESET_SEED=dev
SEED_USER_PASSWORD_FILE=../../deploy/compose/.secrets/seed_user_password
WORKER_CONCURRENCY=5
LOG_LEVEL=debug
