# Salin ke apps/api/.env untuk menjalankan api di luar Docker. Jalankan `pnpm dev:secrets` lebih dulu.
APP_ENV=dev
APP_VERSION=0.0.0
PORT=3000
PROCESS_ROLE=api
MASTER_KEY_FILE=../../deploy/compose/.secrets/cikal_master_key
DATABASE_URL=postgres://cikal_app:cikal_app@localhost:55432/cikal
DATABASE_MIGRATION_URL=postgres://cikal_owner:cikal_owner@localhost:55432/cikal
S3_ENDPOINT=http://localhost:9000
# Host S3 untuk URL unduhan di browser; kosong = S3_ENDPOINT. SIT ke atas: https://files.<DOMAIN> (DEPLOYMENT_PLAN §3.5).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cikal-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_FILE=../../deploy/compose/.secrets/s3_access_key
S3_SECRET_KEY_FILE=../../deploy/compose/.secrets/s3_secret_key
GOTENBERG_URL=http://localhost:3001
# Mailpit menampung email dev; UI di http://localhost:8025. Relay beautentikasi butuh SMTP_USER dan SMTP_PASSWORD_FILE.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.id
SESSION_COOKIE_SECURE=false
MONITORING_TOKEN_FILE=../../deploy/compose/.secrets/monitoring_token
ENABLE_RESET_API=true
RESET_API_TOKEN_FILE=../../deploy/compose/.secrets/reset_token
DEFAULT_RESET_SEED=dev
ALLOW_SIMULATION_ADAPTERS=true
# Tanpa REGION_API_KEY_FILE, sinkronisasi wilayah memakai adapter simulasi.
REGION_API_URL=https://oksara.senar.id
# REGION_API_KEY_FILE=../../deploy/compose/.secrets/oksara_key
SEED_USER_PASSWORD_FILE=../../deploy/compose/.secrets/seed_user_password
WORKER_CONCURRENCY=5
LOG_LEVEL=debug
