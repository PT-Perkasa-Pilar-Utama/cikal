        }
      },
      "checkConstraints": {
        "products_product_code_check": {
          "name": "products_product_code_check",
          "value": "\"product\".\"products\".\"product_code\" ~ '^[A-Za-z0-9]{1,5}$'"
        },
        "products_product_name_check": {
          "name": "products_product_name_check",
          "value": "char_length(\"product\".\"products\".\"product_name\") <= 100"
        },
        "products_product_category_check": {
          "name": "products_product_category_check",
          "value": "\"product\".\"products\".\"product_category\" in ('COLLATERAL', 'NON_COLLATERAL', 'PENSION', 'SYARIAH')"
        },
        "products_interest_type_check": {
          "name": "products_interest_type_check",
          "value": "\"product\".\"products\".\"interest_type\" in ('FLAT', 'EFFECTIVE', 'FLOATING', 'HYBRID', 'CAPPED')"
        },
        "products_plafond_check": {
          "name": "products_plafond_check",
          "value": "\"product\".\"products\".\"max_plafond\" > \"product\".\"products\".\"min_plafond\""
        },
        "products_limit_auto_approval_check": {
          "name": "products_limit_auto_approval_check",
          "value": "\"product\".\"products\".\"limit_auto_approval\" <= \"product\".\"products\".\"max_plafond\""
        },
        "products_valid_to_check": {
          "name": "products_valid_to_check",
          "value": "\"product\".\"products\".\"valid_to\" >= \"product\".\"products\".\"valid_from\""
        }
