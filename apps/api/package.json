{
  "name": "@cikal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node ../../tools/package-builder/generate.mjs --manifest ../../deploy/manifests/poc.json --out src/licensed-modules.generated.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "pnpm run build && node dist/platform/migrate/run.js migrate",
    "db:seed": "pnpm run build && node dist/platform/migrate/run.js seed",
    "db:reset": "pnpm run build && node dist/platform/migrate/run.js reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@cikal/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.11.3",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cikal/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
