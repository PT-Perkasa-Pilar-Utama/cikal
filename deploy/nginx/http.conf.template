# Konfigurasi HTTP sementara untuk penerbitan sertifikat pertama (DEPLOYMENT_PLAN §3.6 langkah 5, §3.7).
# Diproses envsubst image nginx saat container start: ${DOMAIN} dan ${STORAGE_UPSTREAM} dari environment compose.

# DNS Docker dibaca ulang tiap 10 detik: api yang di-restart saat rilis (§4.3) bisa mendapat IP baru.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;
    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        set $api_upstream http://api:3000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}

# Host unduhan dokumen (S3_PUBLIC_ENDPOINT). Header Host diteruskan apa adanya karena tanda tangan SigV4 memuatnya.
server {
    listen 80;
    server_name files.${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        set $storage_upstream http://${STORAGE_UPSTREAM};
        proxy_pass $storage_upstream;
        proxy_set_header Host $http_host;
        proxy_buffering off;
    }
}
