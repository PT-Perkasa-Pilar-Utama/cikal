# Production VM aplikasi: salin ke /opt/cikal/.env (DEPLOYMENT_PLAN §3.2, §3.5). Tidak ada reset dan akun seed.
CIKAL_API_IMAGE=ghcr.io/pt-perkasa-pilar-utama/cikal-api:0.1.0-poc@sha256:<digest>
CIKAL_WEB_IMAGE=ghcr.io/pt-perkasa-pilar-utama/cikal-web:0.1.0-poc@sha256:<digest>

# Compose dan nginx. STORAGE_UPSTREAM: SeaweedFS di VM data, tujuan proxy files.${DOMAIN}.
DOMAIN=cikal.example.id
ACME_EMAIL=ops@example.id
COMPOSE_PROFILES=
STORAGE_UPSTREAM=10.10.0.20:9000

# Aplikasi
APP_ENV=production
APP_VERSION=0.1.0
PUBLIC_BASE_URL=https://cikal.example.id
LOG_LEVEL=info

# Database di VM data lewat jaringan privat
DATABASE_URL=postgres://cikal_app:__DB_APP_PASSWORD__@10.10.0.20:5432/cikal
DATABASE_MIGRATION_URL=postgres://cikal_owner:__DB_OWNER_PASSWORD__@10.10.0.20:5432/cikal
DATABASE_POOL_MAX=20

# Object storage di VM data
S3_ENDPOINT=http://10.10.0.20:9000
S3_PUBLIC_ENDPOINT=https://files.cikal.example.id
S3_REGION=us-east-1
S3_BUCKET=cikal-prod
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key

# Layanan internal dan kunci
GOTENBERG_URL=http://gotenberg:3000
MASTER_KEY_FILE=/run/secrets/cikal_master_key
LICENSE_FILE=/etc/cikal/license.json
SESSION_COOKIE_SECURE=true
MONITORING_TOKEN_FILE=/run/secrets/monitoring_token

# Email
SMTP_HOST=smtp.relay.example.id
SMTP_PORT=587
SMTP_USER=cikal-prod
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=no-reply@example.id

# Integrasi: adapter asli saja (IN-03)
REGION_API_URL=https://oksara.senar.id
REGION_API_KEY_FILE=/run/secrets/oksara_key
ALLOW_SIMULATION_ADAPTERS=false
WORKER_CONCURRENCY=5
